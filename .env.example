# Copy to .env in your working folder. Never commit .env.

# Upstox (real-time data, and orders in live mode). Token expires daily at 03:30 IST.
UPSTOX_ACCESS_TOKEN=

# Zerodha Kite Connect (orders in live mode). Token expires daily at 06:00 IST.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Must be exactly 1 before any live API order is sent.
LIVE_TRADING=
